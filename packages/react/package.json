{
  "name": "@katana-icons/react",
  "version": "0.8.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./trading": {
      "types": "./src/trading.d.ts",
      "default": "./src/trading.js"
    },
    "./styles.css": "./styles.css",
    "./trading.css": "./trading.css",
    "./kanji": {
      "types": "./src/kanji.d.ts",
      "default": "./src/kanji.js"
    },
    "./general": {
      "types": "./src/general/index.d.ts",
      "default": "./src/general/index.js"
    },
    "./general/lucide": {
      "types": "./src/general/lucide.d.ts",
      "default": "./src/general/lucide.js"
    },
    "./small": {
      "types": "./src/small/index.d.ts",
      "default": "./src/small/index.js"
    }
  },
  "files": [
    "src",
    "styles.css",
    "trading.css"
  ],
  "peerDependencies": {
    "react": ">=18"
  }
}
